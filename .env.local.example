# Copy this file to `.env.local` (gitignored) and adjust as needed.
# Both the main app (vite.config.ts) and the docs site
# (docs/.vitepress/config.ts) read from here at dev-server startup.

# Comma-separated list of hostnames the Vite dev server will accept
# requests from. Supports Vite's leading-dot wildcard syntax
# (".example.com" matches any subdomain of example.com).
# Default if unset: localhost
WARP_ALLOWED_HOSTS=localhost,my-dev-host.example.com,.example.com

# URL of the deployed documentation site. When set, the viewer's
# top-right Links menu includes a "Documentation" entry; when unset,
# the entry is omitted (so a build with no docs site doesn't ship a
# broken link). Vite-prefixed (VITE_*) so the value is exposed to
# client-side code via import.meta.env.
VITE_WARP_DOCS_URL=https://janeliascicomp.github.io/warp-atlas-viewer/
